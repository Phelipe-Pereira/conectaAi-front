@startuml Middleware Multigateways de Pagamento

skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #E8F4FD
    BorderColor #0066CC
    ArrowColor #0066CC
}

title Diagrama de Casos de Uso - Middleware Multigateways de Pagamento

' Definição dos atores
actor "Sistema Cliente" as SC #0066CC
actor "Administrador do Sistema" as AS #FF6600
actor "Gateway de Pagamento" as GP #00CC66

' Definição do sistema
rectangle "Middleware Multigateways de Pagamento" {
    ' Casos de uso do Sistema Cliente
    usecase "Enviar requisição de pagamento" as UC1
    usecase "Consultar status da transação" as UC2
    usecase "Receber resposta padronizada" as UC3
    usecase "Receber fallback automático" as UC4
    
    ' Casos de uso do Administrador do Sistema
    usecase "Cadastrar novo gateway" as UC5
    usecase "Definir regras de prioridade e fallback" as UC6
    usecase "Visualizar logs e histórico de requisições" as UC7
    usecase "Configurar ambiente sandbox" as UC8
    
    ' Casos de uso do Gateway de Pagamento
    usecase "Receber requisição formatada" as UC9
    usecase "Retornar status de pagamento" as UC10
    usecase "Simular falha para fallback" as UC11
}

' Relacionamentos do Sistema Cliente
SC --> UC1 : <<include>>
SC --> UC2 : <<include>>
UC1 --> UC3 : <<extend>>
UC2 --> UC3 : <<extend>>
UC1 --> UC4 : <<extend>>
UC2 --> UC4 : <<extend>>

' Relacionamentos do Administrador do Sistema
AS --> UC5 : <<include>>
AS --> UC6 : <<include>>
AS --> UC7 : <<include>>
AS --> UC8 : <<include>>

' Relacionamentos do Gateway de Pagamento
GP --> UC9 : <<include>>
GP --> UC10 : <<include>>
GP --> UC11 : <<extend>>

' Relacionamentos internos do sistema
UC1 --> UC9 : <<include>>
UC2 --> UC10 : <<include>>
UC5 --> UC6 : <<extend>>
UC7 --> UC8 : <<extend>>

' Notas técnicas
note right of UC1
  **Observações Técnicas:**
  - Ambiente sandbox apenas
  - Sem dados sensíveis
  - Requisições normalizadas
  - Logs mantidos
end note

note right of UC4
  **Fallback Automático:**
  - Gateway principal falha
  - Sistema alternativo ativado
  - Transparência para cliente
end note

note right of UC7
  **Monitoramento:**
  - Histórico completo
  - Logs de falhas
  - Métricas de performance
end note

@enduml 