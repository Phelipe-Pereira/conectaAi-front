@startuml Middleware Multigateways de Pagamento

skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome

' Definição de cores por fase
skinparam usecase {
    BackgroundColor #E8F4FD
    BorderColor #0066CC
    ArrowColor #0066CC
}

title Diagrama de Casos de Uso - Middleware Multigateways de Pagamento

' Definição dos atores
actor "Sistema Cliente" as SC #0066CC
actor "Administrador do Sistema" as AS #FF6600
actor "Gateway de Pagamento" as GP #00CC66

' Definição do sistema
rectangle "Middleware Multigateways de Pagamento" {
    ' FASE 1 - Autenticação e Configuração Básica (Azul)
    usecase "Cadastrar novo gateway" as UC5 #87CEEB
    usecase "Configurar ambiente sandbox" as UC8 #87CEEB
    
    ' FASE 2 - Gestão de Usuários e Dashboard (Verde)
    usecase "Visualizar logs e histórico de requisições" as UC7 #90EE90
    usecase "Definir regras de prioridade e fallback" as UC6 #90EE90
    
    ' FASE 3 - Integração com Gateways (Laranja)
    usecase "Enviar requisição de pagamento" as UC1 #FFB347
    usecase "Receber requisição formatada" as UC9 #FFB347
    usecase "Retornar status de pagamento" as UC10 #FFB347
    
    ' FASE 4 - Processamento e Resposta (Vermelho)
    usecase "Consultar status da transação" as UC2 #FF6B6B
    usecase "Receber resposta padronizada" as UC3 #FF6B6B
    usecase "Receber fallback automático" as UC4 #FF6B6B
    
    ' FASE 5 - Testes e Simulação (Roxo)
    usecase "Simular falha para fallback" as UC11 #DDA0DD
}

' Relacionamentos do Sistema Cliente
SC --> UC1 : <<include>>
SC --> UC2 : <<include>>
UC1 --> UC3 : <<extend>>
UC2 --> UC3 : <<extend>>
UC1 --> UC4 : <<extend>>
UC2 --> UC4 : <<extend>>

' Relacionamentos do Administrador do Sistema
AS --> UC5 : <<include>>
AS --> UC6 : <<include>>
AS --> UC7 : <<include>>
AS --> UC8 : <<include>>

' Relacionamentos do Gateway de Pagamento
GP --> UC9 : <<include>>
GP --> UC10 : <<include>>
GP --> UC11 : <<extend>>

' Relacionamentos internos do sistema
UC1 --> UC9 : <<include>>
UC2 --> UC10 : <<include>>
UC5 --> UC6 : <<extend>>
UC7 --> UC8 : <<extend>>

' Legenda das fases
legend right
  |= Fase |= Cor |= Descrição |
  | 1 | <#87CEEB>   </#87CEEB> | Autenticação e Configuração |
  | 2 | <#90EE90>   </#90EE90> | Gestão de Usuários |
  | 3 | <#FFB347>   </#FFB347> | Integração Gateways |
  | 4 | <#FF6B6B>   </#FF6B6B> | Processamento |
  | 5 | <#DDA0DD>   </#DDA0DD> | Testes e Simulação |
endlegend

' Notas técnicas
note right of UC1
  **Observações Técnicas:**
  - Ambiente sandbox apenas
  - Sem dados sensíveis
  - Requisições normalizadas
  - Logs mantidos
end note

note right of UC4
  **Fallback Automático:**
  - Gateway principal falha
  - Sistema alternativo ativado
  - Transparência para cliente
end note

note right of UC7
  **Monitoramento:**
  - Histórico completo
  - Logs de falhas
  - Métricas de performance
end note

@enduml 