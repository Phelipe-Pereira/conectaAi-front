@startuml ConectaAi_Casos_Uso

skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome
skinparam packageStyle rectangle

' Definição de cores
skinparam usecase {
    BackgroundColor #E8F4FD
    BorderColor #007AFF
    ArrowColor #007AFF
}

title Diagrama de Casos de Uso - Conecta Ai Gateway\nBackend Java 21 + Spring Boot 3.5.5

' Definição dos atores
actor "Sistema Cliente" as SC
actor "Administrador" as AS
actor "Gateway de Pagamento" as GP

' Definição do sistema
rectangle "Conecta Ai Gateway" {
    
    package "Gestão de Clientes" {
        usecase "UC001: Cadastrar Cliente" as UC001
        usecase "UC002: Consultar Cliente" as UC002
        usecase "UC003: Atualizar Cliente" as UC003
        usecase "UC004: Excluir Cliente" as UC004
    }
    
    package "Gestão de Pagamentos" {
        usecase "UC005: Criar Pagamento" as UC005
        usecase "UC006: Consultar Pagamento" as UC006
        usecase "UC007: Cancelar Pagamento" as UC007
        usecase "UC008: Processar Webhook" as UC008
    }
    
    package "Gestão de Assinaturas" {
        usecase "UC009: Criar Assinatura" as UC009
        usecase "UC010: Consultar Assinatura" as UC010
        usecase "UC011: Pausar Assinatura" as UC011
        usecase "UC012: Retomar Assinatura" as UC012
        usecase "UC013: Cancelar Assinatura" as UC013
    }
    
    package "Gestão de Estornos" {
        usecase "UC014: Solicitar Estorno" as UC014
        usecase "UC015: Consultar Estorno" as UC015
        usecase "UC016: Processar Estorno" as UC016
    }
    
    package "Gestão de Webhooks" {
        usecase "UC017: Receber Webhook Asaas" as UC017
        usecase "UC018: Receber Webhook Stripe" as UC018
        usecase "UC019: Receber Webhook Mercado Pago" as UC019
        usecase "UC020: Processar Evento Webhook" as UC020
        usecase "UC021: Validar Assinatura Webhook" as UC021
    }
    
    package "Controle de Idempotência" {
        usecase "UC022: Verificar Idempotência" as UC022
        usecase "UC023: Salvar Resposta Idempotente" as UC023
        usecase "UC024: Limpar Chaves Expiradas" as UC024
    }
    
    package "Administração do Sistema" {
        usecase "UC025: Configurar Gateway" as UC025
        usecase "UC026: Selecionar Provider" as UC026
        usecase "UC027: Monitorar Saúde" as UC027
        usecase "UC028: Visualizar Métricas" as UC028
        usecase "UC029: Processar Mensagens Assíncronas" as UC029
    }
}

